NODE_ENV=development
PORT=3001
APP_URL=http://127.0.0.1:3001
# Mode Produksi: https://tk-wa.masyithohkotategal.my.id

# Keamanan Akses Antar-Server & Webhook
INTERNAL_API_KEY=Haisen.WhatsApp_Relay.Tegal_2026!w8
WEBHOOK_HMAC_SECRET=secret_webhook_hmac_masyithoh_2026
CORE_SERVER_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/wa-distribution/callback
# Mode Produksi: https://tk-rapor-api.masyithohkotategal.my.id/api/v1/wa-distribution/callback

# IP Whitelisting (Pisahkan dengan koma)
ALLOWED_ORIGIN_IPS=127.0.0.1,::1

# Kapasitas Multi-Session
MAX_CONCURRENT_SESSIONS=50
SESSION_STORAGE_PATH=./sessions

# Antrean & Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optimasi & Anti-Ban Baileys (Per Session)
MIN_DELAY_SECONDS=3
MAX_DELAY_SECONDS=8
MAX_RETRY_ATTEMPTS=3
STREAM_BUFFER_TIMEOUT_MS=30000
